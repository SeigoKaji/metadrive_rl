# Python / test caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Local Python environment and runtime cache
.venv/
.venv-*/
.runtime/

# Training artefacts (keep directory placeholders only)
models/*
!models/.gitkeep
logs/*
!logs/monitor/
!logs/tensorboard/
logs/monitor/*
!logs/monitor/.gitkeep
logs/tensorboard/*
!logs/tensorboard/.gitkeep

# Generated inspection/evaluation artefacts (keep the directory placeholder only)
outputs/*
!outputs/.gitkeep

# Panda3D / editor noise
panda3d-log.txt
.idea/
.vscode/
